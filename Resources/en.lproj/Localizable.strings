<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 终端设置正确标题前显示的通用标题 -->
	<key>TERMINAL</key>
	<string>终端</string>

	<!-- 设置页面的标题 -->
	<key>SETTINGS</key>
	<string>设置</string>

	<!-- 关于页面的标题 -->
	<key>ABOUT</key>
	<string>关于 NewTerm</string>

	<!-- 密码管理器按钮的旁白标签 -->
	<key>PASSWORD_MANAGER</key>
	<string>密码管理器</string>

	<!-- 终端启动失败时显示的消息 -->
	<key>TERMINAL_LAUNCH_FAILED</key>
	<string>Shell 进程意外退出。</string>

	<!-- 终端无法启动时显示的警告标题 -->
	<key>TERMINAL_LAUNCH_FAILED_TITLE</key>
	<string>无法启动终端，因为 Shell 进程意外退出。</string>

	<!-- 终端无法启动时显示的警告内容 -->
	<key>TERMINAL_LAUNCH_FAILED_BODY</key>
	<string>请参阅终端窗口中的错误信息以获取更多详情。
您可能需要检查启动脚本或重新安装核心软件包来解决此问题。</string>

	<!-- 终端进程结束时显示的标题 -->
	<key>PROCESS_COMPLETED_TITLE</key>
	<string>会话已结束</string>

	<!-- 新建标签按钮的旁白标签 -->
	<key>NEW_TAB</key>
	<string>新建标签</string>

	<!-- 关闭标签按钮的旁白标签 -->
	<key>CLOSE_TAB</key>
	<string>关闭标签</string>

	<!-- 新建窗口按钮的旁白标签 -->
	<key>NEW_WINDOW</key>
	<string>新建窗口</string>

	<!-- 关闭窗口按钮的旁白标签 -->
	<key>CLOSE_WINDOW</key>
	<string>关闭窗口</string>

	<!-- 清除终端按钮的旁白标签 -->
	<key>CLEAR_TERMINAL</key>
	<string>清除终端</string>

	<!-- 显示密码管理器按钮的旁白标签 -->
	<key>PASSWORD_MANAGER</key>
	<string>密码管理器</string>

	<!-- 选择上一个标签的键盘快捷键标签 -->
	<key>SHOW_PREVIOUS_TAB</key>
	<string>显示上一个标签</string>

	<!-- 选择下一个标签的键盘快捷键标签 -->
	<key>SHOW_NEXT_TAB</key>
	<string>显示下一个标签</string>

	<!-- 水平拆分标签并在下方添加新终端的按钮旁白标签 -->
	<key>SPLIT_HORIZONTALLY</key>
	<string>水平拆分</string>

	<!-- 垂直拆分标签并在右侧添加新终端的按钮旁白标签 -->
	<key>SPLIT_VERTICALLY</key>
	<string>垂直拆分</string>

	<!-- 使用操作系统区域语言的设置选项。%@ 是用户的系统语言 -->
	<key>LOCALE_SYSTEM</key>
	<string>系统语言：%@</string>
</dict>
</plist>
